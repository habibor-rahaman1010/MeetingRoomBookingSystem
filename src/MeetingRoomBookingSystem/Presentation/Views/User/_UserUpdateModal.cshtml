@model RegistrationModel;

@{
    ViewData["Title"] = "Register";
}

<!-- Modal for editing a category -->
<div class="modal fade" id="updateUserModal" tabindex="-1" role="dialog" aria-labelledby="updateUserModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateUserModalLabel">Update The User</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="updateUserForm" asp-action="UpdateUser" asp-controller="User" asp-antiforgery="true" method="post">
                    <input asp-for="Id" type="hidden" id="updateUserId" name="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <label>Name</label>
                        <input asp-for="Name" class="form-control" autocomplete="Name" aria-required="true" placeholder="Name" id="name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="Email" aria-required="true" placeholder="Enter your email" id="email"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <label>Pin</label>
                        <input asp-for="Pin" class="form-control" autocomplete="Pin" aria-required="true" placeholder="Pin" id="pin" />
                        <span asp-validation-for="Pin" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <label>Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="PhoneNumber" aria-required="true" placeholder="Phone Number" id="phoneNumber" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>


                    <div class="form-floating mb-3">
                        <div class="form-group">
                            <label>Department</label>
                            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-control" id="department"></select>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <label>Designation</label>
                        <input asp-for="Designation" class="form-control" aria-required="true" placeholder="Designation" id="designation" />
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>

                    <div>
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
