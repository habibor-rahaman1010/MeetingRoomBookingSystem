@model MeetingRoomDashboardModel

@{
    ViewData["Title"] = "Meeting Room Dashboard";
}

<div class="container mt-5">
    <h1 class="text-center">Meeting Room Dashboard</h1>
    <div class="row">
        <!-- Calendar Sidebar -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5>Calendar</h5>
                    <input type="date" class="form-control mb-3">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action">Week View</a>
                        <a href="#" class="list-group-item list-group-item-action">Month View</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meeting Rooms -->
        <div class="col-md-9">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Meeting Room</th>
                            <th>Saturday</th>
                            <th>Sunday</th>
                            <th>Monday</th>
                            <th>Tuesday</th>
                            <th>Wednesday</th>
                            <th>Thursday</th>
                            <th>Friday</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in Model.MeetingRooms)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary">@room.Name</span>
                                </td>
                                @for (int i = 0; i < 7; i++)
                                {
                                    <td>
                                        <button class="btn btn-light w-100">+</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

}