@{
    ViewData["Title"] = "Meeting Room List";
    Layout = "_SecondLayout";
}

<style>
    .toast {
        background-color: #28a745;
        color: white;
    }

    .toast-body {
        width: 100%;
        text-align: center;
    }

</style>

@section Styles {
    <!-- DataTables -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
}

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="meetingToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body d-flex" id="toastMessage">
            <!-- Toast message will be dynamically set here -->
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card mt-5">
                    <div class="card-header">
                        <h3 class="card-title">Meeting Room List: </h3>

                        <a class="btn btn-primary float-right" data-toggle="modal" data-target="#meetingModal">
                            <i class="nav-icon"></i>
                            <i class="fas fa-plus"></i> Create Meeting Room
                        </a>


                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="meetingroom" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Photo</th>
                                    <th>Meeting Room Name</th>
                                    <th>Facilities</th>
                                    <th>Capacity</th>
                                    <th>Meeting Room Color</th>  
                                    <th>QR Code</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tfoot>
                                <tr>
                                    <th>Photo</th>
                                    <th>Meeting Room Name</th>
                                    <th>Facilities</th>
                                    <th>Capacity</th>
                                    <th>Meeting Room Color</th>
                                    <th>QR Code</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<partial name="_MeetingCreateModal" />
<partial name="_MeetingUpdateModal" />


<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="modal-default-label" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-default-label">Confirmation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p></p> <!-- Message goes here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- /.content -->
@section Scripts {

    <!-- DataTables  & Plugins -->
    <script src="~/adminlte/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/adminlte/plugins/jszip/jszip.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/adminlte/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script type="text/javascript">
        //Load data in table used by DataTable...
        $(function () {
            $("#meetingroom").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                ajax: {
                    url: "/MeetingRoom/GetMeetingRoomJsonDataAsync",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        return JSON.stringify(d);
                    },
                },

                columnDefs: [
             
                    {
                        orderable: false,
                        targets: 7,
                        render: function (data, type, row) {
                            return `<button type="button" class="btn btn-info btn-sm edit-meeting" data-id='${data}' data-toggle="modal" data-target="#meetingRoomUpdateModal">
                                                        <i class="fas fa-pencil-alt"></i> Edit
                                                    </button>

                                                    <button type="submit" class="btn btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                                        <i class="fas fa-trash">
                                                        </i>
                                                        Delete
                                                    </button>`;
                        }
                    },

                ],
            }).buttons().container().appendTo('#meetingroom_wrapper .col-md-6:eq(0)');
        });

        //This code for delete meeting room
        $('#meetingroom').on('click', '.show-bs-modal', function () {
            let id = $(this).data("id");
            console.log(id);
            let modal = $("#modal-default");
            modal.find('.modal-body p').text('Are you sure you want to delete this record?');
            $("#deleteId").val(id);
            $("#deleteForm").attr("action", "/MeetingRoom/MeetingRoomDelete");
            modal.modal('show');
        });

        $("#deleteButton").click(function () {
            $("#deleteForm").submit();
        });     
        


        //This is meeting room update funtion
        $(document).ready(function () {
            // Handle the click event for the edit button
            $('#meetingroom').on('click', '.edit-meeting', function () {
                var meetingRoomeId = $(this).data('id');
                console.log("button is clicked");
                console.log(meetingRoomeId);

                // Use AJAX to fetch the category data
                $.ajax({
                    url: '/MeetingRoom/MeetingRoomById',
                    method: 'GET',
                    data: { id: meetingRoomeId },
                    success: function (response) {
                        if (response.success) {
                            console.log(response.data);
                            // Populate the modal fields with the category data
                            $('#editMeetingId').val(response.data.id);
                            $('#editName').val(response.data.name);
                            $('#editFacilities').val(response.data.facilities);
                            $('#editCapacity').val(response.data.capacity);
                            $('#editColor').val(response.data.color);
                            $('#editAvailableDay').val(response.data.availableDay);
                            $('#editAvailableTime').val(response.data.availableTime);

                            var imageUrl = "/" + response.data.imageUrl;
                            $('#currentImage').attr('src', imageUrl);

                            // Open the modal (bootstrap handles this)
                            $('#meetingRoomUpdateModal').modal('show');
                        }
                        else {
                            alert('Error fetching metting room  data');
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 403) {
                            // Redirect to Access Denied page if the status is 403
                            window.location.href = '/Account/AccessDenied';
                        }
                        else {
                            alert('An error occurred while fetching the meeting data.');
                        }
                    }
                });
            });   
        });

        //This code for temp data response fadeOut
        $(document).ready(function () {
            setTimeout(function () {
                $('#response-alert').fadeOut('slow');
            }, 3000);
        });

    </script>
}