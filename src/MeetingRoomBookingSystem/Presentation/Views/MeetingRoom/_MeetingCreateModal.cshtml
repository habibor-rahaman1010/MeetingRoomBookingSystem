@model MeetingRoomCreateModel;

@{
    ViewData["Title"] = "Register";  
}

<div class="modal fade" id="meetingModal" tabindex="-1" role="dialog" aria-labelledby="meetingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header ">
                <h5 class="modal-title" id="meetingModalLabel">Create Meeting Room</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="createMeetingForm" asp-action="MeetingRoomAdd" asp-controller="MeetingRoom" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="Name">Meeting Room Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Meeting Room Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Facilities">Facilities <span class="text-danger">*</span></label>
                        <input asp-for="Facilities" class="form-control" placeholder="Facilities" />
                        <span asp-validation-for="Facilities" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Capacity">Capacity <span class="text-danger">*</span></label>
                                <input asp-for="Capacity" class="form-control" placeholder="Capacity" />
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <div class="form-group">
                                    <label asp-for="Color">Color <span class="text-danger">*</span></label>
                                    <input asp-for="Color" class="form-control" placeholder="Color" />
                                    <span asp-validation-for="Color" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="AvailableDay" class="control-label"></label>
                                <select asp-for="AvailableDay" class="form-control" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
                                <span asp-validation-for="AvailableDay" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="AvailableTime">Time <span class="text-danger">*</span></label>
                                <input asp-for="AvailableTime" type="time" class="form-control" placeholder="Time" />
                                <span asp-validation-for="AvailableTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageFile" class="control-label">Product image <span class="text-danger">*</span></label>
                        <div id="imagePreviewContainer"></div>
                        <div class="custom-file">
                            <label class="custom-file-label" asp-for="ImageFile">Choose your file</label>
                            <input style="cursor:pointer" asp-for="ImageFile" class="custom-file-input" id="roomImage">
                            <p id="imageError"></p>
                        </div>
                        <p class="mt-2">Max File size: 5MB <br /> Allowed File: .jpeg, .jpg, .png <br /> Aspect ratio should be 1:1</p>
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-block">Confirm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
        document.getElementById('roomImage').addEventListener('change', function (e) {
        var reader = new FileReader();
        reader.onload = function (event) {
            var imagePreview = document.createElement('img');
            imagePreview.src = event.target.result;
            imagePreview.style.maxWidth = '200px';
            document.getElementById('imagePreviewContainer').appendChild(imagePreview);
        };
        reader.readAsDataURL(e.target.files[0]);
    });

</script>
